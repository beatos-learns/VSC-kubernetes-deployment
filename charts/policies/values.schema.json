{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["applicationNamespaces", "images"],
  "properties": {
    "global": { "type": "object" },
    "applicationNamespaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "signer", "acmeSolver"],
      "properties": {
        "registry": { "type": "string", "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$" },
        "acmeSolver": { "type": "string", "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+$" },
        "signer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "subjectRegExp", "rekorUrl"],
          "properties": {
            "issuer": { "type": "string", "pattern": "^https://" },
            "subjectRegExp": { "type": "string", "minLength": 1 },
            "rekorUrl": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    }
  }
}
