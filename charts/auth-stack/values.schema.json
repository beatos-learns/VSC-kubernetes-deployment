{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "generic-stack": { "type": "object" },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "securityHeaders": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "hstsSeconds": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "dbSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "files"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "repository"],
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" }
          }
        },
        "resources": { "type": "object" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z0-9._-]+\\.sql$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mysqlSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "files"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "repository", "tag", "digest"],
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "resources": { "type": "object" },
        "files": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z0-9._-]+\\.sql$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "interval", "scrapeTimeout", "alerts"],
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "$ref": "#/definitions/duration" },
        "scrapeTimeout": { "$ref": "#/definitions/duration" },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "errorRatePercent", "latencySeconds", "loginUri", "loginFailuresPerSecond"],
          "properties": {
            "enabled": { "type": "boolean" },
            "errorRatePercent": { "type": "number", "minimum": 0, "maximum": 100 },
            "latencySeconds": { "type": "number", "exclusiveMinimum": 0 },
            "loginUri": { "type": "string", "pattern": "^/" },
            "loginFailuresPerSecond": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "namespacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceQuota", "limitRange", "networkPolicy"],
      "properties": {
        "resourceQuota": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "requests", "limits", "pods", "storage", "persistentVolumeClaims"],
          "properties": {
            "enabled": { "type": "boolean" },
            "requests": { "$ref": "#/definitions/cpuMemory" },
            "limits": { "$ref": "#/definitions/cpuMemory" },
            "pods": { "type": "integer", "minimum": 1 },
            "storage": { "$ref": "#/definitions/quantity" },
            "persistentVolumeClaims": { "type": "integer", "minimum": 0 }
          }
        },
        "limitRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "container"],
          "properties": {
            "enabled": { "type": "boolean" },
            "container": {
              "type": "object",
              "additionalProperties": false,
              "required": ["defaultRequest", "default", "max"],
              "properties": {
                "defaultRequest": { "$ref": "#/definitions/cpuMemory" },
                "default": { "$ref": "#/definitions/cpuMemory" },
                "max": { "$ref": "#/definitions/cpuMemory" }
              }
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "ingressControllerNamespace", "dnsNamespace", "acmeSolver", "monitoring", "database", "modulesDatabase"],
          "properties": {
            "enabled": { "type": "boolean" },
            "ingressControllerNamespace": { "type": "string", "minLength": 1 },
            "dnsNamespace": { "type": "string", "minLength": 1 },
            "acmeSolver": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "port"],
              "properties": {
                "enabled": { "type": "boolean" },
                "port": { "$ref": "#/definitions/port" }
              }
            },
            "monitoring": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "namespace"],
              "properties": {
                "enabled": { "type": "boolean" },
                "namespace": { "type": "string", "minLength": 1 }
              }
            },
            "database": { "$ref": "#/definitions/databaseEndpoint" },
            "modulesDatabase": { "$ref": "#/definitions/databaseEndpoint" }
          }
        }
      }
    }
  },
  "definitions": {
    "quantity": { "type": ["string", "integer"], "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|M|Mi|G|Gi|T|Ti)?$" },
    "duration": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "databaseEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidr", "port"],
      "properties": {
        "cidr": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" }
      }
    }
  }
}
