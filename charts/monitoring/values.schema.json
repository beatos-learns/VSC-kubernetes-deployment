{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object" },
    "kube-prometheus-stack": { "type": "object" },
    "dashboards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "labelValue"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "labelValue": { "type": "string", "minLength": 1 }
      }
    }
  }
}
