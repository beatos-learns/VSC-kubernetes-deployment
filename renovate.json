{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "argocd": {
    "fileMatch": ["^argocd/.+\.ya?ml$"]
  },
  "packageRules": [
    {
      "description": "charts/monitoring and charts/monitoring-crds must move together: validate.yml requires the same operator appVersion in both",
      "matchPackageNames": ["/(kube-prometheus-stack|prometheus-operator-crds)$/"],
      "groupName": "prometheus-operator"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\.github/workflows/.+\.ya?ml$"],
      "matchStrings": ["cosign-release: (?<currentValue>v[0-9][0-9.]*)"],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": ["^\.github/workflows/.+\.ya?ml$"],
      "matchStrings": ["HELM_VERSION: (?<currentValue>v[0-9][0-9.]*)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "the MySQL client of the module service's seed Job (charts/auth-stack mysqlSeed): tag and digest move together",
      "customType": "regex",
      "fileMatch": ["^charts/auth-stack/values\.yaml$"],
      "matchStrings": ["registry: (?<registryUrl>docker\\.io)\\s+repository: (?<depName>library/mysql)\\s+tag: \"(?<currentValue>[^\"]+)\"\\s+digest: (?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
