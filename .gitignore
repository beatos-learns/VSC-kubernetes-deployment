/.idea/

/NOTES.md
/VSC_Orchestrierung.pdf
/CI-REPO-NOTES.md

/kubeconfig/
*-kubeconfig.yaml

# what the validate workflow renders and downloads; also left behind when the
# same checks are run locally to reproduce a red PR
/rendered-*.yaml
/kubeconform
/kustomize
/yq

# helm dependency artifacts (vendored on demand via `helm dependency build`)
/charts/auth-stack/charts/
/charts/monitoring/charts/
*.tgz
*.pdf

# terraform/ - state and provider binaries stay local; .terraform.lock.hcl is
# committed on purpose (pins the provider build), *.tfvars only when they hold
# nothing sensitive (the API token is an environment variable, never a tfvar)
/terraform/.terraform/
/terraform/*.tfstate
/terraform/*.tfstate.*
/terraform/*.tfplan
/terraform/crash.log
/terraform/*.auto.tfvars
/terraform/secrets.tfvars
